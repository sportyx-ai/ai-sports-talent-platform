# ============================================================
# Environment Variables Template for Sportyx Server
# Copy this file to .env or set these in your terminal / shell
# ============================================================

# Active Profile: 'local' (offline persistent H2) or 'prod' (Supabase/PostgreSQL)
# SPRING_PROFILES_ACTIVE=local


# Database Connection (Supabase PostgreSQL)
# Option 1: Direct Connection (IPv6 supported networks)
DB_URL=jdbc:postgresql://db.mkabcbiaemyorforibip.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password_here

# Option 2: Supabase Pooler (IPv4 & IPv6 supported - Session Mode)
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.mkabcbiaemyorforibip
# DB_PASSWORD=your_supabase_database_password_here

# Option 3: Local PostgreSQL (if running locally on your machine)
# DB_URL=jdbc:postgresql://localhost:5432/postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your_local_postgres_password
